# FTP / FTPS connection settings
# Copy this file to .env in the repository root and enter your credentials.
FTP_HOST=""
FTP_USER=""
FTP_PASSWORD=""
# Replace this with the server-side public data directory.
FTP_REMOTE_DIR="/path/to/public/data"
FTP_PHOTO_DIR="repot"
FTP_THUMB_DIR="repot-thumb"
FTP_PROTOCOL="ftps"
FTP_PORT="21"
FTP_TIMEOUT="60"

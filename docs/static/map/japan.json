{
  "version": 8,
  "name": "レポっと / シンプル",
  "metadata": {
    "openmaptiles:version": "3.x",
    "repot:description": "地名・駅名・地形・道路のコントラストを全体的に高めた、シンプルな写真アーカイブ用スタイル",
    "repot:source": "https://armd-01.sakura.ne.jp/tiles/"
  },
  "glyphs": "https://tile.openstreetmap.jp/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "url": "pmtiles://https://tiles.yukimat.jp/japan.pmtiles",
      "type": "vector",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f1f3ee"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass",
            "farmland",
            "wetland"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#d0e0c8",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c4d9ba",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "industrial",
            "commercial",
            "railway"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#dfe4e1",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-color": "#b9d4e2",
        "fill-antialias": true
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 10,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9bbfd3",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.5,
          16,
          1.4,
          18,
          2.4
        ]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "in",
          [
            "get",
            "admin_level"
          ],
          [
            "literal",
            [
              2,
              3,
              4
            ]
          ]
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#96aab6",
        "line-width": 0.7,
        "line-opacity": 0.8,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "#c6d1d7",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "road-area",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#ffffff",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "road-major-outline",
      "type": "line",

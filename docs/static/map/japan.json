      "paint": {
        "line-color": "#a5b5c0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.6,
          10,
          1.5,
          14,
          3.8,
          18,
          7.5
        ],
        "line-opacity": 1
      }
    },

      "paint": {
        "line-color": "#8a9faa",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.45,
          16,
          0.7,
          18,
          0.9
        ],
        "line-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "brunnel"
            ],
            "tunnel"
          ],
          0.35,
          0.7
        ]
